{
  "name": "agent-pulse",
  "version": "0.11.1",
  "private": false,
  "description": "Evidence-backed embodied-data production intelligence and decision system.",
  "author": "susuyan",
  "homepage": "https://susuyan.github.io/eai-pulse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susuyan/eai-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/susuyan/eai-pulse/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/cli/serve.ts",
    "start": "tsx src/cli/serve.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:snapshot": "tsx src/cli/snapshot.ts",
    "migrate:embodied": "tsx src/cli/migrate-embodied-data.ts",
    "preview:embodied": "tsx src/cli/preview-embodied-data.ts",
    "collect": "tsx src/cli/collect.ts",
    "sources:audit": "tsx src/cli/audit-sources.ts",
    "sources:proposal:validate": "tsx src/cli/validate-source-proposal.ts",
    "sources:proposal:import": "tsx src/cli/import-source-proposal.ts",
    "sources:health:issue": "tsx src/cli/render-source-health-issue.ts",
    "weekly:issue": "tsx src/cli/render-weekly-brief.ts",
    "public:fingerprint": "tsx src/cli/public-content-fingerprint.ts",
    "public:validate": "tsx src/cli/validate-public-site.ts",
    "repair:provenance": "tsx src/cli/repair-provenance.ts",
    "repair:activations": "tsx src/cli/repair-activations.ts",
    "repair:review-noise": "tsx src/cli/repair-review-noise.ts",
    "activate": "tsx src/cli/activate.ts",
    "activate:auto": "tsx src/cli/auto-activate.ts",
    "observe:sources": "tsx src/cli/observe-sources.ts",
    "ops:reconcile": "tsx src/cli/autonomous-operations.ts",
    "scout:generate": "tsx src/cli/scout.ts",
    "evaluate:system": "tsx src/cli/evaluate.ts",
    "evolve": "tsx src/cli/evolve.ts",
    "monitor": "tsx src/cli/monitor-cli.ts",
    "monitor:check": "tsx src/cli/monitor-check.ts",
    "monitor:decide": "tsx src/cli/monitor-alert-decision.ts",
    "monitor:incident": "tsx src/cli/merge-monitor-incident.ts",
    "research:impact": "tsx src/cli/research-impact.ts",
    "release:check": "tsx src/cli/release-notes.ts --check",
    "release:notes": "tsx src/cli/release-notes.ts",
    "export": "tsx src/cli/export.ts",
    "auto:publish": "tsx src/cli/auto-publish.ts",
    "ai:enrich": "tsx src/cli/enrich-events.ts",
    "narrative:stage": "tsx src/cli/promote-narrative-stage.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run export && npm run public:validate"
  },
  "keywords": [
    "embodied-ai",
    "embodied-data",
    "robot-data",
    "data-pipeline",
    "industry-intelligence"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.4",
    "better-sqlite3": "^12.4.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "kysely": "^0.28.8",
    "mysql2": "^3.24.4",
    "undici": "^7.29.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
